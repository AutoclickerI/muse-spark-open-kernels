+inline size_t hicache_registered_bytes_remaining(const void* ptr) {
+  using QueryFn = CUresult (*)(unsigned int, CUpointer_attribute*, void**, CUdeviceptr);
+  static const QueryFn query = []() {
+    void* symbol = nullptr;
+    cudaDriverEntryPointQueryResult status;
+    host::RuntimeDeviceCheck(cudaGetDriverEntryPointByVersion(
+        "cuPointerGetAttributes", &symbol, 11000, cudaEnableDefault, &status));
+    host::RuntimeCheck(status == cudaDriverEntryPointSuccess && symbol != nullptr, "CUDA pointer range query unavailable");
+    return reinterpret_cast<QueryFn>(symbol);
+  }();
+  CUdeviceptr base = 0;
+  size_t bytes = 0;
+  CUpointer_attribute attrs[] = {CU_POINTER_ATTRIBUTE_RANGE_START_ADDR, CU_POINTER_ATTRIBUTE_RANGE_SIZE};
+  void* values[] = {&base, &bytes};
+  const auto address = reinterpret_cast<CUdeviceptr>(ptr);
+  const auto result = query(2, attrs, values, address);
+  host::RuntimeCheck(result == CUDA_SUCCESS, "CUDA pointer range query failed: ", static_cast<int>(result));
+  // Unregistered host pointers have zero range attributes. They retain one
+  // copy per page; never merge across an unknown or separate registration.
+  return base <= address && address - base < bytes ? bytes - (address - base) : 0;
+}
