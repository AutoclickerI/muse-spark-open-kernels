+_GROUPED_MOD = None
+
+
+def _grouped_module():
+    global _GROUPED_MOD
+    if _GROUPED_MOD is None:
+        import hashlib
+        import os
+        from torch.utils.cpp_extension import load_inline
+
+        arch = torch.cuda.get_device_capability()
+        previous = os.environ.get("TORCH_CUDA_ARCH_LIST")
+        os.environ["TORCH_CUDA_ARCH_LIST"] = (
+            "9.0a" if arch == (9, 0) else f"{arch[0]}.{arch[1]}"
+        )
+        try:
+            tag = hashlib.sha1(GROUPED_CUDA_SRC.encode()).hexdigest()[:12]
+            _GROUPED_MOD = load_inline(
+                name=f"muse_canonical_serving_{tag}",
+                cpp_sources=GROUPED_CPP_SRC,
+                cuda_sources=GROUPED_CUDA_SRC,
+                functions=["route", "gemm"],
+                extra_cuda_cflags=["-O3", "-std=c++20", "-lineinfo"],
+                verbose=False,
+            )
+        finally:
+            if previous is None:
+                os.environ.pop("TORCH_CUDA_ARCH_LIST", None)
+            else:
+                os.environ["TORCH_CUDA_ARCH_LIST"] = previous
+    return _GROUPED_MOD
+
+
+def _grouped_call(data, state):
+    x = data["hidden_states"].contiguous()
+    ids = data["topk_ids"].to(torch.int32).contiguous()
+    cfg = data["config"]
+    assert cfg["local_count"] == NLOC and cfg["d_hidden"] == H and cfg["d_expert"] == H
+    m = x.shape[0]
+    count = m * TOPK
+    dev = x.device
+    counts = torch.empty((NLOC,), dtype=torch.int32, device=dev)
+    offsets = torch.empty((NLOC + 1,), dtype=torch.int32, device=dev)
+    cursors = torch.empty((NLOC,), dtype=torch.int32, device=dev)
+    pairs = torch.empty((count,), dtype=torch.int32, device=dev)
+    positions = torch.empty((count,), dtype=torch.int32, device=dev)
+    tasks = torch.empty((5 * (NLOC + 1),), dtype=torch.int32, device=dev)
+    inter = torch.empty((count, H), dtype=torch.bfloat16, device=dev)
+    y = torch.empty_like(inter)
+    mod = state["grouped_mod"]
+    mod.route(
+        ids, counts, offsets, cursors, pairs, positions, tasks,
+        cfg["local_start"], 0,
+    )
+    grid = state["grid"] * 4
+    mod.gemm(
+        state["w13p"], state["gs13_gate"], state["gs13_up"], x, inter,
+        pairs, offsets, tasks, 1, 0, grid, 2,
+    )
+    mod.gemm(
+        state["w2p"], state["gs2"], state["gs2"], inter, y,
+        pairs, offsets, tasks, 0, 0, grid, 2,
+    )
+    safe = positions.clamp_min(0)
+    dense = y.index_select(0, safe).view(m, TOPK, H)
+    flat = torch.arange(count, device=dev, dtype=torch.int32).view(m, TOPK)
+    valid = (ids >= cfg["local_start"]) & (ids < cfg["local_start"] + NLOC)
+    return dense, torch.where(valid, flat, torch.full_like(flat, -1))
+
+
+def _v9_call(data, state, *, return_dense=False):
+    cfg = data["config"]
+    assert cfg["local_count"] == NLOC and cfg["d_hidden"] == H and cfg["d_expert"] == H
+    mod = state["mod"]
+    x = data["hidden_states"].contiguous()
+    ids = data["topk_ids"].to(torch.int32).contiguous()
+    tw = data["topk_weights"].to(torch.float32).contiguous()
+    m = x.shape[0]
+    npairs = m * TOPK
+    nt = 1
+    nstage = 2
+    while nstage > 1 and mod.smem_needed(nt, nstage, m) > mod.smem_optin:
+        nstage -= 1
+    if mod.smem_needed(nt, nstage, m) > mod.smem_optin:
+        raise ValueError(f"batch {m} too large for fused V9 shared-memory routing")
+    dev = x.device
+    inter = torch.empty((npairs, H), dtype=torch.bfloat16, device=dev)
+    y = torch.zeros((npairs, H), dtype=torch.float32, device=dev)
+    ss = torch.empty((npairs,), dtype=torch.float32, device=dev)
+    pos_map = torch.empty((npairs,), dtype=torch.int32, device=dev)
+    out = torch.empty((m, H), dtype=torch.bfloat16, device=dev)
+    # Counters are per invocation so concurrent serving streams cannot reuse a
+    # generation/barrier state. Cooperative launch below makes the grid resident.
+    cnt = torch.zeros((NCNT,), dtype=torch.int32, device=dev)
+    mod.run(
+        x, ids, tw, state["pnw"], state["w13p"], state["w2p"],
+        state["gs13_gate"], state["gs13_up"], state["gs2"], inter, y, ss,
+        pos_map, cnt, out, 1, cfg["local_start"], nt, nstage,
+        state["grid"] * mod.resident_blocks(nt, nstage, m),
+    )
+    safe_map = pos_map.clamp_min(0)
+    dense = y.index_select(0, safe_map).to(torch.bfloat16).view(m, TOPK, H)
+    flat = torch.arange(npairs, device=dev, dtype=torch.int32).view(m, TOPK)
+    valid = (ids >= state["local_start"]) & (ids < state["local_start"] + NLOC)
+    return dense, torch.where(valid, flat, torch.full_like(flat, -1))
+
+
+def prepare(weights, *, local_start=0):
+    dev = weights["w13"].device
+    t = torch.arange(NT1, device=dev)
+    i = torch.arange(8, device=dev)
+    rowmap1 = torch.cat((8 * t[:, None] + i, H + 8 * t[:, None] + i), 1)
+    rowmap2 = torch.arange(H, device=dev).view(NT2, 16)
+    w13p = torch.empty((NLOC, NT1, TILE_BYTES), dtype=torch.uint8, device=dev)
+    w2p = torch.empty((NLOC, NT2, TILE_BYTES), dtype=torch.uint8, device=dev)
+    for e in range(NLOC):
+        w13p[e] = _repack(weights["w13"][e], weights["w13_sf"][e], rowmap1)
+        w2p[e] = _repack(weights["w2"][e], weights["w2_sf"][e], rowmap2)
+    mod = _module()
+    grouped_mod = _grouped_module()
+    props = torch.cuda.get_device_properties(dev)
+    torch.cuda.synchronize()
+    return {
+        "w13p": w13p,
+        "w2p": w2p,
+        "gs13_gate": weights["w13_gs_gate"][:NLOC].float().contiguous(),
+        "gs13_up": weights["w13_gs_up"][:NLOC].float().contiguous(),
+        "gs2": weights["w2_gs"][:NLOC].float().contiguous(),
+        "pnw": weights["post_norm_w"].contiguous(),
+        "grid": props.multi_processor_count,
+        "mod": mod,
+        "grouped_mod": grouped_mod,
+        "local_start": int(local_start),
+    }
+
+
+def kernel_fn(data, state, *, return_dense=False):
+    m = data["hidden_states"].shape[0]
+    dense, local_map = (
+        _grouped_call(data, state)
+        if m >= 256
+        else _v9_call(data, state, return_dense=return_dense)
+    )
+    if return_dense:
+        return dense, local_map
+    valid = local_map >= 0
+    norm = (1.0 + state["pnw"]).to(torch.bfloat16)
+    scaled = dense * norm
+    inv = torch.rsqrt(
+        scaled.float().square().mean(dim=-1, keepdim=True) + 1.0e-8
+    )
+    weights = data["topk_weights"].to(torch.bfloat16) * valid.to(torch.bfloat16)
+    return (scaled * inv.to(torch.bfloat16) * weights.unsqueeze(-1)).sum(dim=1)
+
+
+def prepare_layer(layer):
+    """Pack raw ModelOpt tensors into the single canonical V9 bank."""
+    post_norm = getattr(layer, "post_expert_norm", None)
+    if post_norm is None or getattr(post_norm, "weight", None) is None:
+        raise RuntimeError("Muse V9 needs the loaded post-expert norm weight")
+    weights = {
+        "w13": layer.gate_up_proj.detach(),
+        "w13_sf": layer.gate_up_proj_weight_scale.detach(),
+        "w13_gs_gate": layer.gate_up_proj_weight_scale_2[:, 0].detach(),
+        "w13_gs_up": (
+            layer.gate_up_proj_weight_scale_2[:, 1].detach()
+            if layer.gate_up_proj_weight_scale_2.shape[1] >= 2
+            else layer.gate_up_proj_weight_scale_2.reshape(-1).detach()
+        ),
+        "w2": layer.down_proj.detach(),
+        "w2_sf": layer.down_proj_weight_scale.detach(),
+        "w2_gs": layer.down_proj_weight_scale_2.detach(),
+        "post_norm_w": post_norm.weight.detach(),
+    }
+    if weights["w13"].shape[0] != NLOC:
+        raise ValueError(f"Muse V9 expects 32 local experts, got {weights['w13'].shape[0]}")
+    return prepare(weights, local_start=layer.local_expert_offset)
+
+
+def run_layer(state, hidden_states, topk_scores, topk_ids, *, return_dense=False):
+    """Graph-capturable V9/grouped invocation used by MuseSpark1xFp4Experts."""
+    cfg = {
+        "bs": hidden_states.shape[0],
+        "d_hidden": hidden_states.shape[1],
+        "d_expert": H,
+        "local_start": state["local_start"],
+        "local_count": NLOC,
+    }
+    return kernel_fn(
+        {
+            "hidden_states": hidden_states,
+            "topk_weights": topk_scores,
+            "topk_ids": topk_ids,
+            "config": cfg,
+        },
+        state,
+        return_dense=return_dense,
+    )
diff --git a/python/sglang/srt/layers/muse_spark_serving.py b/python/sglang/srt/layers/muse_spark_serving.py
new file mode 100644
index 0000000..c9f1c96
--- /dev/null
+++ b/python/sglang/srt/layers/muse_spark_serving.py
@@ -0,0 +1,144 @@
+"""Muse serving dispatch around independently owned expert/projection kernels."""
+
+from __future__ import annotations
+
+import time
+
+import torch
+from sglang.srt.layers.muse_proj import MuseProjection, projection_supported
+from sglang.kernels.ops.muse_spark_v12.gemm_ag import projection_max_tokens
+
+
+def run_v9_dense(state, x, scores, ids):
+    """Dense finalize ABI for an admitted V9 verify producer, through M256."""
+    from sglang.srt.layers.muse_spark_moe import H, NLOC, TOPK, _v9_call
+
+    if x.shape[0] > 256:
+        raise ValueError("V9 is not admitted for prefill; use stock Marlin")
+    mod = state["mod"]
+    # Bound shared-memory routing independently of the expert implementation.
+    lo, hi = 1, 256
+    while lo < hi:
+        mid = (lo + hi + 1) // 2
+        if mod.smem_needed(1, 1, mid) <= mod.smem_optin:
+            lo = mid
+        else:
+            hi = mid - 1
+    capacity = max(1, lo // 8 * 8)
+    rows, maps = [], []
+    for begin in range(0, x.shape[0], capacity):
+        chunk = x[begin : begin + capacity]
+        data = {
+            "hidden_states": chunk,
+            "topk_ids": ids[begin : begin + capacity],
+            "topk_weights": scores[begin : begin + capacity],
+            "config": {
+                "local_count": NLOC,
+                "d_hidden": H,
+                "d_expert": H,
+                "local_start": state["local_start"],
+            },
+        }
+        dense, mapping = _v9_call(data, state, return_dense=True)
+        rows.append(dense)
+        maps.append(
+            torch.where(mapping >= 0, mapping + begin * TOPK, mapping)
+            if begin
+            else mapping
+        )
+    return (rows[0], maps[0]) if len(rows) == 1 else (torch.cat(rows), torch.cat(maps))
+
+
+class ProjectionMethod:
+    """Keep RowParallelLinear's original reduction and symmetric allocation."""
+
+    def __init__(self, original, projection):
+        self.original = original
+        self.projection = projection
+
+    def __getattr__(self, name):
+        return getattr(self.original, name)
+
+    def apply(self, layer, x, bias=None):
+        if bias is None and projection_supported(x, layer.weight, "o"):
+            return self.projection(x)
+        return self.original.apply(layer, x, bias=bias)
+
+
+def prepare_projections(model):
+    """Prepare once after load, using actual full and multicast-slice shapes.
+
+    Shape plans are shared by MuseProjection, but every derived layout belongs
+    to its loaded weight. A model-wide tuning budget avoids per-layer sweeps.
+    """
+    from sglang.srt.distributed import get_tp_group
+    from sglang.srt.layers.quantization.unquant import UnquantizedLinearMethod
+    from sglang.srt.models.muse_spark import MuseSpark1xAttention, MuseSpark1xMoE
+
+    deadline = time.monotonic() + 45
+    for module in model.modules():
+        if isinstance(module, MuseSpark1xAttention):
+            linear = module.o_proj
+            x = linear.weight.new_empty((8, linear.weight.shape[1]))
+            if isinstance(
+                linear.quant_method, UnquantizedLinearMethod
+            ) and projection_supported(x, linear.weight, "o"):
+                op = MuseProjection(
+                    linear.weight,
+                    "o",
+                    budget_s=min(15, max(0, deadline - time.monotonic())),
+                )
+                linear.quant_method = ProjectionMethod(linear.quant_method, op)
+        elif isinstance(module, MuseSpark1xMoE):
+            for kind, linear, attribute in (
+                ("pooler", module.pre_expert_proj, "_pooler"),
+                ("unpooler", module.post_expert_proj, "_unpooler"),
+            ):
+                if linear is None or not hasattr(linear, "weight"):
+                    continue
+                w = linear.weight
+                x = w.new_empty((8, w.shape[1]))
+                if not projection_supported(x, w, kind):
+                    continue
+                comm = get_tp_group().ca_comm if module.tp_size == 8 else None
+                sharded = (
+                    comm is not None
+                    and getattr(comm, "has_multicast", False)
+                    and not comm.disabled
+                )
+                limit = projection_max_tokens(comm.world_size, w.shape[0], w.device) if sharded else 0
+                tokens = (8, 16, 32, 64, 128, 256)
+                setattr(
+                    module,
+                    attribute,
+                    MuseProjection(
+                        w,
+                        kind,
+                        tokens=tuple(m for m in tokens if m > limit),
+                        budget_s=min(15, max(0, deadline - time.monotonic())),
+                    ),
+                )
+                if sharded:
+                    n = w.shape[0] // comm.world_size
+                    local = w[comm.rank * n : (comm.rank + 1) * n]
+                    setattr(
+                        module,
+                        attribute + "_local",
+                        MuseProjection(
+                            local,
+                            kind,
+                            tokens=tuple(m for m in tokens if m <= limit),
+                            budget_s=min(15, max(0, deadline - time.monotonic())),
+                        ),
+                    )
+            # DenseRouterPlan and PrefillGemmPlan remain unbound until the
+            # cand_v11_gemm H200 receipt admits their serving shapes.
+            module._prefill_dense_router = None
+
+
+def project(x, weight, kind, prepared):
+    if prepared is not None and projection_supported(x, weight, kind):
+        return prepared(x)
+    from sglang.srt.layers.quantization.unquant import bf16_gemm_dispatch
+
+    return bf16_gemm_dispatch(x, weight, None)
diff --git a/python/sglang/srt/layers/muse_verify_attention.py b/python/sglang/srt/layers/muse_verify_attention.py
new file mode 100644
index 0000000..ece0a38
--- /dev/null
+++ b/python/sglang/srt/layers/muse_verify_attention.py
@@ -0,0 +1,187 @@
+"""Capture-safe paged FP8 verify attention for Muse.
+
+QK norm, RoPE, the FP8 query cast, and the new K/V writes are performed by
+Muse's existing fused QK op. This module consumes that layout and computes
+the causal/windowed attention over the paged cache. Each request/KV-head/
+token program shares its K/V tile across the eight GQA rows. FA3 remains the
+caller's fallback for non-unit scales, non-contiguous pools, and other shapes.
+"""
+
+from __future__ import annotations
+
+from typing import Optional
+
+import torch
+
+try:
+    import triton
+    import triton.language as tl
+except ImportError:  # pragma: no cover - serving images include Triton
+    triton = None
+    tl = None
+
+
+_BLOCK_K = 64
+
+
+if triton is not None:
+
+    @triton.jit
+    def _muse_verify_kernel(
+        q, k_cache, v_cache, page_table, cache_seqlens, out,
+        q_s0, q_s1, q_s2, k_s0, k_s1, k_s2, k_s3,
+        v_s0, v_s1, v_s2, v_s3, pt_s0, pt_s1, o_s0, o_s1, o_s2,
+        max_pages, max_keys, softmax_scale, window_left,
+        Q_LEN: tl.constexpr, KV_HEADS: tl.constexpr, GROUP: tl.constexpr,
+        PAGE_SIZE: tl.constexpr, HEAD_DIM: tl.constexpr, BLOCK_K: tl.constexpr,
+    ):
+        """One request/KV head, one draft token, all GQA heads.
+
+        The K/V tile is loaded once into this program and reused by the eight
+        query rows. Splitting the eight tokens across programs bounds the
+        accumulator register footprint while retaining page reuse inside each
+        token's GQA group.
+        """
+        pid = tl.program_id(0)
+        token = pid % Q_LEN
+        kv_linear = pid // Q_LEN
+        b = kv_linear // KV_HEADS
+        hk = kv_linear - b * KV_HEADS
+        seq_total = tl.load(cache_seqlens + b)
+        seq_base = seq_total - Q_LEN
+        qpos = seq_base + token
+        qrows = tl.arange(0, GROUP)
+        dims = tl.arange(0, HEAD_DIM)
+        qheads = hk * GROUP + qrows
+        qptr = q + (b * Q_LEN + token) * q_s0 + qheads[:, None] * q_s1 + dims[None, :] * q_s2
+        qv = tl.load(qptr, mask=True, other=0.0).to(tl.float32)
+        # A finite sentinel avoids ``-inf - -inf`` in tiles that are entirely
+        # outside a short sliding window.
+        m = tl.full((GROUP,), -1.0e30, tl.float32)
+        l = tl.zeros((GROUP,), tl.float32)
+        acc = tl.zeros((GROUP, HEAD_DIM), tl.float32)
+        lo = 0 if window_left < 0 else tl.maximum(0, qpos - window_left)
+
+        for key0 in tl.range(0, max_keys, BLOCK_K):
+            ko = key0 + tl.arange(0, BLOCK_K)
+            valid = ko < max_keys
+            valid = valid & (ko <= qpos) & (ko >= lo)
+            logical_page = ko // PAGE_SIZE
+            in_page = ko - logical_page * PAGE_SIZE
+            phys_page = tl.load(
+                page_table + b * pt_s0 + logical_page * pt_s1,
+                mask=(logical_page < max_pages), other=0,
+            )
+            # Keep page and in-page offsets separate: serving pools are
+            # [physical_page, page_slot, kv_head, dim], while page-1 reduces
+            # to the familiar scattered-row layout.
+            kptr = (
+                k_cache + phys_page[:, None] * k_s0 + in_page[:, None] * k_s1
+                + hk * k_s2 + dims[None, :] * k_s3
+            )
+            vptr = (
+                v_cache + phys_page[:, None] * v_s0 + in_page[:, None] * v_s1
+                + hk * v_s2 + dims[None, :] * v_s3
+            )
+            kval = tl.load(kptr, mask=valid[:, None], other=0.0).to(tl.float32)
+            vval = tl.load(vptr, mask=valid[:, None], other=0.0).to(tl.float32)
+            logits = tl.sum(qv[:, None, :] * kval[None, :, :], axis=2) * softmax_scale
+            logits = tl.where(valid[None, :], logits, -1.0e30)
+            tile_m = tl.max(logits, axis=1)
+            new_m = tl.maximum(m, tile_m)
+            old_scale = tl.exp(m - new_m)
+            probs = tl.where(valid[None, :], tl.exp(logits - new_m[:, None]), 0.0)
+            new_l = l * old_scale + tl.sum(probs, axis=1)
+            acc = acc * old_scale[:, None] + tl.sum(probs[:, :, None] * vval[None, :, :], axis=1)
+            m = new_m
+            l = new_l
+
+        ov = acc / l[:, None]
+        optr = out + (b * Q_LEN + token) * o_s0 + qheads[:, None] * o_s1 + dims[None, :] * o_s2
+        tl.store(optr, ov.to(out.dtype.element_ty), mask=True)
+
+
+def supports_muse_verify(
+    q: torch.Tensor,
+    key_cache: torch.Tensor,
+    value_cache: torch.Tensor,
+    page_table: torch.Tensor,
+    cache_seqlens: torch.Tensor,
+    *,
+    q_len: int,
+    num_q_heads: int,
+    num_kv_heads: int,
+    head_dim: int,
+    k_descale: Optional[torch.Tensor] = None,
+    v_descale: Optional[torch.Tensor] = None,
+) -> bool:
+    """Static shape/layout predicate used before CUDA-graph capture."""
+    return bool(
+        triton is not None
+        and q.is_cuda
+        and q_len == 8
+        and head_dim == 64
+        and num_q_heads == 8 * num_kv_heads
+        and q.ndim == 3
+        and key_cache.ndim == 4
+        and value_cache.shape == key_cache.shape
+        and q.dtype == torch.float8_e4m3fn
+        and key_cache.dtype == torch.float8_e4m3fn
+        and value_cache.dtype == torch.float8_e4m3fn
+        and key_cache.is_contiguous()
+        and value_cache.is_contiguous()
+        and page_table.dtype == torch.int32
+        and cache_seqlens.dtype == torch.int32
+        and page_table.is_contiguous()
+        and cache_seqlens.is_contiguous()
+        and k_descale is None
+        and v_descale is None
+    )
+
+
+def run_muse_verify_attention(
+    q: torch.Tensor,
+    key_cache: torch.Tensor,
+    value_cache: torch.Tensor,
+    page_table: torch.Tensor,
+    cache_seqlens: torch.Tensor,
+    *,
+    softmax_scale: float,
+    window_left: int,
+    out: Optional[torch.Tensor] = None,
+) -> torch.Tensor:
+    """Run paged verify attention with serving FA3 layouts.
+
+    ``cache_seqlens`` includes the eight newly stored draft rows. The kernel
+    derives each request's base length and applies ``key <= base + token`` plus
+    ``window_left``. No host values are read in the launch, so graph replay is
+    safe.
+    """
+    if triton is None:
+        raise RuntimeError("Triton is required for Muse verify attention")
+    batch = page_table.shape[0]
+    q_len = q.shape[0] // batch
+    num_q_heads, head_dim = q.shape[1], q.shape[2]
+    num_kv_heads = key_cache.shape[2]
+    if not supports_muse_verify(
+        q, key_cache, value_cache, page_table, cache_seqlens,
+        q_len=q_len, num_q_heads=num_q_heads, num_kv_heads=num_kv_heads,
+        head_dim=head_dim,
+    ):
+        raise ValueError("unsupported Muse verify layout")
+    if out is None:
+        out = torch.empty((q.shape[0], num_q_heads, head_dim), dtype=torch.bfloat16, device=q.device)
+    if out.shape != (q.shape[0], num_q_heads, head_dim) or out.dtype != torch.bfloat16:
+        raise ValueError("out must be [tokens, heads, 64] BF16")
+    grid = (batch * num_kv_heads * q_len,)
+    _muse_verify_kernel[grid](
