diff --git a/python/sglang/srt/managers/dflash_kv_graph.py b/python/sglang/srt/managers/dflash_kv_graph.py
new file mode 100644
index 0000000..0b8631f
--- /dev/null
+++ b/python/sglang/srt/managers/dflash_kv_graph.py
@@ -0,0 +1,69 @@
+"""Replay DFlash's committed-context KV writes without per-layer host launches."""
+
+import logging
+
+import torch
+
+from sglang.srt.distributed.parallel_state import graph_capture
+
+logger = logging.getLogger(__name__)
+
+
+class DFlashKVGraph:
+    """One ordered forward stream; exact batch shapes and stock arithmetic.
+
+    Graphs share scratch because materializations never overlap each other.
+    All inputs are refreshed on the forward stream before each replay. Zero
+    commit lengths make startup capture safe for the live KV pool, including
+    the padding slot. Prefill keeps its variable-length eager path.
+    """
+
+    def __init__(self, worker, max_bs):
+        self.block_size = int(worker.block_size)
+        fc = worker.draft_model.fc
+        width = int(fc.input_size if hasattr(fc, "input_size") else fc.in_features)
+        device = worker.model_runner.device
+        tokens = max_bs * self.block_size
+        self.hidden = torch.zeros((tokens, width), dtype=fc.weight.dtype, device=device)
+        self.locations = torch.zeros(tokens, dtype=torch.int64, device=device)
+        self.positions = torch.zeros_like(self.locations)
+        self.lengths = torch.zeros(max_bs, dtype=torch.int32, device=device)
+        self.graphs = {}
+        self.pool = torch.cuda.graph_pool_handle()
+        with torch.inference_mode(), graph_capture() as context:
+            for bs in range(max_bs, 0, -1):
+                n = bs * self.block_size
+                args = dict(
+                    target_hidden=self.hidden[:n],
+                    cache_loc=self.locations[:n],
+                    cache_loc_2d=self.locations[:n].view(bs, self.block_size),
+                    positions=self.positions[:n],
+                    commit_lens=self.lengths[:bs],
+                )
+                # Initialize libraries/JITs outside capture. Capturing never
+                # changes the model or the set of committed cache rows.
+                worker._append_target_hidden_to_draft_kv_by_loc(**args)
+                context.stream.synchronize()
+                graph = torch.cuda.CUDAGraph()
+                with torch.cuda.graph(graph, pool=self.pool, stream=context.stream):
+                    worker._append_target_hidden_to_draft_kv_by_loc(**args)
+                self.graphs[bs] = graph
+        # The fused helper allocates its projection/K/V workspaces outside
+        # capture. A larger prefill replaces those tensors; graphs still use
+        # their old addresses, so retain their storage for every replay.
+        helper = worker._fused_kv_helper
+        self.workspace_refs = (
+            (helper._proj_workspace, helper._k_workspace, helper._v_workspace)
+            if helper is not None else ()
+        )
+        torch.cuda.current_stream().wait_stream(context.stream)
+        logger.info("DFLASH committed-context KV graphs captured for batch sizes 1..%d", max_bs)
+
+    def __call__(self, *, target_hidden, cache_loc, cache_loc_2d, positions, commit_lens):
+        bs = commit_lens.numel()
+        n = bs * self.block_size
+        self.hidden[:n].copy_(target_hidden)
+        self.locations[:n].copy_(cache_loc)
+        self.positions[:n].copy_(positions)
+        self.lengths[:bs].copy_(commit_lens)
+        self.graphs[bs].replay()
diff --git a/python/sglang/srt/managers/dflash_overlap.py b/python/sglang/srt/managers/dflash_overlap.py
new file mode 100644
index 0000000..f17efe5
--- /dev/null
+++ b/python/sglang/srt/managers/dflash_overlap.py
@@ -0,0 +1,99 @@
+"""Prepare the following DFlash batch while target verification is on device."""
+
+from copy import copy
+
+
+class DFlashOverlap:
+    def __init__(self, scheduler):
+        self.scheduler = scheduler
+        self.prepared = None
+        self.processed_previous = False
+
+    def needs_first_token_flush(self, last_batch):
+        # Prefill's first token is ready, but launching the next forward before
+        # processing its result holds that token behind another whole batch.
+        # Middle chunks have no token to deliver; keep their normal pipeline.
+        return bool(
+            last_batch
+            and not self.scheduler.require_mlp_sync
+            and last_batch.spec_algorithm.is_dflash()
+            and last_batch.forward_mode.is_extend()
+            and last_batch.contains_last_prefill_chunk
+            and self.scheduler.result_queue
+            and not self.processed_previous
+        )
+
+    def take_prepared(self):
+        plan, self.prepared = self.prepared, None
+        if plan is None:
+            # Ordinary result processing can finish rows as well as the early
+            # callback. Remove those rows before prefill admission; otherwise
+            # their occupied slots force another decode before the next turn.
+            running = self.scheduler.running_batch
+            if (
+                running.spec_algorithm is not None
+                and running.spec_algorithm.is_dflash()
+                and any(req.finished() for req in running.reqs)
+            ):
+                running.filter_batch()
+                running.batch_is_full = False
+        if plan is not None and plan.batch_to_run is not None:
+            # Control messages are ingested after preparation. In particular an
+            # abort must remove its row before launching the prepared batch.
+            plan.batch_to_run.filter_batch()
+            if plan.batch_to_run.is_empty():
+                plan.batch_to_run = None
+        return plan
+
+    def callback(self, batch):
+        s = self.scheduler
+        self.processed_previous = False
+        if not (
+            s.device == "cuda"
+            and batch.spec_algorithm.is_dflash()
+            and batch.forward_mode.is_decode()
+            and not batch.has_grammar
+            and not s.require_mlp_sync
+            and not s.waiting_queue
+            and s.chunked_req is None
+            and not s.enable_hisparse
+            and not getattr(s.model_worker, "_need_mamba_verify_commit", False)
+        ):
+            return None
+
+        # Save scheduler state before forward isolation/verify rebinds its
+        # fields. Requests stay shared: resolving the previous result must
+        # advance their committed lengths before preparing the next batch.
+        running = copy(s.running_batch)
+        running.spec_info = copy(running.spec_info)
+        # Each normal forward creates a fresh draft-input object. Retain the
+        # relay fields, but give this preparation its own scratch as well:
+        # the in-flight step may still reference the old input's buffers.
+        for name in vars(running.spec_info):
+            if name.startswith("_prepare_"):
+                setattr(running.spec_info, name, None)
+
+        def prepare():
+            with s.device_module.stream(s.schedule_stream):
+                # Only target verification still reads the shared mapping.
+                # GPU allocation writes wait for its read-done event; CPU
+                # allocation and request bookkeeping can proceed immediately.
+                s._apply_war_barrier()
+                # A first-token/grammar barrier may already have consumed the
+                # previous result even though last_batch still names its batch.
+                if s.result_queue:
+                    previous_batch, previous_result = s.result_queue.popleft()
+                    s.process_batch_result(previous_batch, previous_result)
+                    self.processed_previous = True
+                    # Sending a completed result lets that conversation submit
+                    # its next turn. Ingress runs in the next scheduler loop;
+                    # preparing decode now would bypass that prefill for a
+                    # whole verify step. Keep the early result processing but
+                    # let ordinary scheduling choose after ingress.
+                    if any(req.finished() for req in running.reqs):
+                        return
+                self.prepared = s.get_next_batch_to_run(
+                    running_batch=running, last_batch=running
+                )
+
+        return prepare
diff --git a/python/sglang/srt/managers/muse_workspace.py b/python/sglang/srt/managers/muse_workspace.py
new file mode 100644
index 0000000..efe959a
--- /dev/null
+++ b/python/sglang/srt/managers/muse_workspace.py
@@ -0,0 +1,23 @@
+"""Stream-owned scratch for the serial Muse router launches and graph replays."""
+
+import torch
+
+
+_router_workspaces = {}
+
+
+def router_workspace(device):
+    """A fixed M256 workspace; never grow buffers referenced by CUDA graphs.
+
+    Muse uses one routing stream across layers. CUDA graph capture uses that
+    same side stream, and its router kernels reset the completion counters.
+    Different routing streams retain independent buffers.
+    """
+    stream = torch.cuda.current_stream(device)
+    key = (stream.device.index, stream.cuda_stream)
+    if key not in _router_workspaces:
+        _router_workspaces[key] = (
+            torch.empty(16 * 17 * 64 * 64, device=device, dtype=torch.float32),
+            torch.zeros(16, device=device, dtype=torch.uint32),
+        )
+    return _router_workspaces[key]
