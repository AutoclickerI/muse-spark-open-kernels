+"""Prepared pooler/router plan for Muse prefill.
+
+The pooler stays BF16, while the router keeps its lossless BF16 hi/lo split
+and FP32 accumulation.  Plans are selected before CUDA graph capture and are
+reused by shape.  The merged path is admitted only when it agrees with the
+separate reference on fresh inputs.
+"""
+
+from __future__ import annotations
+
+import logging
+import statistics
+import time
+
+import torch
+
+logger = logging.getLogger(__name__)
+
+HIDDEN = 8192
+MOE_HIDDEN = 4096
+ROUTER_EXPERTS = 256
+WORKSPACE_BYTES = 128 << 20
+VARIANTS = ("separate", "merged")
+
+
+def dense_router_supported(hidden: torch.Tensor, pooler: torch.Tensor, router: torch.Tensor) -> bool:
+    return (
+        hidden.is_cuda
+        and pooler.is_cuda
+        and router.is_cuda
+        and hidden.device == pooler.device == router.device
+        and hidden.ndim == pooler.ndim == router.ndim == 2
+        and tuple(hidden.shape[1:]) == (HIDDEN,)
+        and pooler.ndim == 2
+        and 0 < pooler.shape[0] <= MOE_HIDDEN
+        and tuple(pooler.shape[1:]) == (HIDDEN,)
+        and tuple(router.shape) == (ROUTER_EXPERTS, HIDDEN)
+        and hidden.dtype == pooler.dtype == torch.bfloat16
+        and router.dtype in (torch.bfloat16, torch.float32)
+        and hidden.is_contiguous()
+        and pooler.is_contiguous()
+        and router.is_contiguous()
+        and 0 < hidden.shape[0] <= 16384
+    )
+
+
+def _router_halves(router: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor]:
+    full = router.float()
+    hi = full.to(torch.bfloat16).contiguous()
+    lo = (full - hi.float()).to(torch.bfloat16).contiguous()
+    return hi, lo
+
+
+def _separate(hidden: torch.Tensor, pooler: torch.Tensor, router_hi: torch.Tensor,
+              router_lo: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor]:
+    pooled = torch.mm(hidden, pooler.t())
+    logits = torch.mm(hidden, router_hi.t(), out_dtype=torch.float32)
+    logits.add_(torch.mm(hidden, router_lo.t(), out_dtype=torch.float32))
+    return pooled, logits
+
+
+def _merged(hidden: torch.Tensor, bank: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor]:
+    # The mixed bank is lossless; the pooler result is rounded at the same
+    # boundary the layer uses before experts consume it.
+    mixed = torch.mm(hidden, bank.t(), out_dtype=torch.float32)
+    pooler_rows = bank.shape[0] - 2 * ROUTER_EXPERTS
+    return mixed[:, :pooler_rows].to(torch.bfloat16), mixed[:, pooler_rows:]
+
+
+def _agrees(got: tuple[torch.Tensor, torch.Tensor], expected: tuple[torch.Tensor, torch.Tensor]) -> bool:
+    pooled, logits = got
+    exp_pooled, exp_logits = expected
+    if pooled.shape != exp_pooled.shape or logits.shape != exp_logits.shape:
+        return False
+    if not bool(torch.isfinite(pooled).all()) or not bool(torch.isfinite(logits).all()):
+        return False
+    pe = float((pooled.float() - exp_pooled.float()).norm() / exp_pooled.float().norm().clamp_min(1e-12))
+    re = float((logits - exp_logits).norm() / exp_logits.norm().clamp_min(1e-12))
+    return pe <= 0.01 and re <= 0.01
+
+
+class _Graph:
+    active = 0
+
+    def __init__(self, fn):
+        self.graph = torch.cuda.CUDAGraph()
+        self.out = None
+        type(self).active += 1
+        try:
+            fn()
+            torch.cuda.synchronize()
+            with torch.cuda.graph(self.graph):
+                self.out = fn()
+            self.graph.replay()
+            torch.cuda.synchronize()
+        except BaseException:
+            self.close()
+            raise
+
+    def replay(self):
+        self.graph.replay()
+
+    def close(self):
+        if getattr(self, "graph", None) is not None:
+            self.graph.reset()
+            self.graph = None
+            self.out = None
+            type(self).active -= 1
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, *_):
+        self.close()
+
+    def __del__(self):
+        self.close()
+
+
+class DenseRouterPlan:
+    """Shape-specialized pooler/router execution selected before graph capture."""
+
+    def __init__(self, pooler: torch.Tensor, router: torch.Tensor,
+                 *, tokens=(753, 3012, 16384), budget_s=15):
+        if (not pooler.is_cuda or not router.is_cuda or pooler.dtype != torch.bfloat16
+                or router.dtype not in (torch.bfloat16, torch.float32)):
+            raise ValueError("DenseRouterPlan requires CUDA BF16 pooler and BF16/FP32 router weights")
+        if (
+            pooler.ndim != 2
+            or not 0 < pooler.shape[0] <= MOE_HIDDEN
+            or tuple(pooler.shape[1:]) != (HIDDEN,)
+            or tuple(router.shape) != (ROUTER_EXPERTS, HIDDEN)
+        ):
+            raise ValueError("unsupported pooler/router shape")
+        if pooler.device != router.device or not pooler.is_contiguous() or not router.is_contiguous():
+            raise ValueError("pooler and router must be contiguous on one CUDA device")
+        if torch.cuda.is_current_stream_capturing():
+            raise RuntimeError("DenseRouterPlan preparation must precede graph capture")
+        self.pooler = pooler.detach()
+        self.router = router.detach()
+        self.router_hi, self.router_lo = _router_halves(self.router)
+        self.bank = torch.cat((self.pooler, self.router_hi, self.router_lo), 0).contiguous()
+        self.plans: dict[int, str] = {}
+        self.timings: dict[int, dict] = {}
+        self.prepare(tokens, budget_s=budget_s)
+
+    def _run(self, hidden: torch.Tensor, variant: str):
+        if variant == "separate":
+            return _separate(hidden, self.pooler, self.router_hi, self.router_lo)
+        if variant == "merged":
+            return _merged(hidden, self.bank)
+        raise ValueError(f"unknown dense/router variant {variant}")
+
+    def _time(self, graph: _Graph, hidden: torch.Tensor, banks: list[torch.Tensor], repeats=4) -> float:
+        start = torch.cuda.Event(enable_timing=True)
+        end = torch.cuda.Event(enable_timing=True)
+        vals = []
+        for rep in range(repeats):
+            hidden.copy_(banks[rep % len(banks)])
+            start.record()
+            graph.replay()
+            end.record()
+            end.synchronize()
+            vals.append(start.elapsed_time(end) * 1000)
+        return statistics.median(vals)
+
+    def prepare(self, tokens=(753, 3012, 16384), *, budget_s=15):
+        deadline = time.monotonic() + max(0.0, budget_s)
+        for m in dict.fromkeys(tokens):
+            if not 0 < m <= 16384:
+                raise ValueError("token counts must be in 1..16384")
+            hidden = torch.randn((m, HIDDEN), device=self.pooler.device, dtype=torch.bfloat16)
+            expected = self._run(hidden, "separate")
+            self.plans[m] = "separate"
+            if time.monotonic() >= deadline:
+                continue
+            banks = [torch.randn_like(hidden) for _ in range(2)]
+            best = (float("inf"), "separate")
+            base_graph = _Graph(lambda: self._run(hidden, "separate"))
+            try:
+                for variant in VARIANTS:
+                    if time.monotonic() >= deadline:
+                        break
+                    try:
+                        graph = _Graph(lambda v=variant: self._run(hidden, v))
+                        try:
+                            if not _agrees(graph.out, expected):
+                                raise ValueError("variant exceeds 1% dense/router agreement guard")
+                            us = self._time(graph, hidden, banks)
+                            if us < best[0]:
+                                best = (us, variant)
+                        finally:
+                            graph.close()
+                    except Exception as exc:  # noqa: BLE001
+                        logger.warning("MUSE_PREFILL_DENSE_REJECT m=%s variant=%s: %s", m, variant, exc)
+                self.plans[m] = best[1]
+                self.timings[m] = {"variant": best[1], "event_us": best[0]}
+            finally:
+                base_graph.close()
+        if _Graph.active:
+            raise RuntimeError("dense/router tuning graphs leaked")
+        return self
+
+    def __call__(self, hidden: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor]:
+        if not dense_router_supported(hidden, self.pooler, self.router):
+            raise ValueError("dense/router call requires CUDA BF16 [tokens,8192] input")
+        return self._run(hidden, self.plans.get(hidden.shape[0], "separate"))
