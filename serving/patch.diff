+        *args,
+        cuda_files=["muse_spark_v12/all_reduce_norm_residual.cuh"],
+        cuda_wrappers=[("run", f"MuseAllReduceNormResidual<{args}>::run")],
+    )
+
+
+def _uses_two_shot_norm(comm, nbytes):
+    # The stock H200 policy selects pull above128KiB. This fused operation has
+    # its own two-shot push/gather implementation; explicit AR overrides stay
+    # authoritative, and capacity is checked separately from that crossover.
+    return not comm.uses_one_shot_push(nbytes) and (
+        comm.override_algo is None or comm.uses_two_shot_push(nbytes)
+    )
+
+
+def all_reduce_norm_residual_supported(group, tokens, hidden):
+    from sglang.srt.distributed.device_communicators.custom_all_reduce_v2 import (
+        CustomAllReduceV2,
+    )
+
+    comm = group.ca_comm
+    if (
+        not isinstance(comm, CustomAllReduceV2)
+        or comm.disabled
+        or comm.world_size not in (2, 4, 8)
+        or not 0 < tokens <= 256
+        or hidden % 1024
+        or torch.cuda.get_device_capability(comm.device)[0] != 9
