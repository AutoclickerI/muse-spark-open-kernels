index 0000000..a177938
--- /dev/null
+++ b/python/sglang/srt/model_executor/muse_kv_capacity.py
@@ -0,0 +1,64 @@
+"""Size Muse's sliding pool for live windows, leaving history in the full pool."""
+
+from sglang.srt.model_executor.pool_configurator import (
+    HybridSWAPoolConfigurator,
+    compute_swa_request_cap,
+)
+from sglang.srt.runtime_context import get_memory, get_schedule
+from sglang.srt.utils.common import ceil_align
+
+
+class MuseKVPoolConfigurator(HybridSWAPoolConfigurator):
+    """Keep active windows, cached resume fragments per request, and prefill.
+
+    The prefix cache can evict an unlocked SWA branch without evicting its full
+    attention history. A live match walks fragments until it covers a window;
+    its boundary fragment can extend the locked span by another window. Reserve
+    two cached windows per request while its extension runs. The standard
+    request cap includes decode preallocation and chunks in flight.
+    """
+
+    @staticmethod
+    def is_applicable(kvc):
+        architectures = kvc.model_config.hf_config.architectures or []
+        return (
+            any(a in architectures for a in (
+                "MuseSpark1xForCausalLM", "MuseSparkForConditionalGeneration"
+            ))
+            and not kvc.is_draft_worker
+            and not get_memory().enable_unified_memory
+            and get_schedule().max_running_requests is not None
+            and get_schedule().chunked_prefill_size is not None
+            and not get_schedule()._swa_full_tokens_ratio_explicitly_set
+            and kvc.sliding_window_size is not None
+            and len(kvc.layer_info.full_attention_layer_ids) > 0
+        )
+
+    def __init__(self, kvc):
+        super().__init__(kvc)
+        requests = get_schedule().max_running_requests // kvc.attn_dp_size
+        self._swa_cap = compute_swa_request_cap(
+            page_size=kvc.page_size,
+            window=kvc.sliding_window_size,
+            attn_dp_size=kvc.attn_dp_size,
+        ) + 2 * requests * (kvc.sliding_window_size + kvc.page_size)
+
+    def calculate_pool_sizes(self, available_bytes, page_size):
+        swa_tokens = ceil_align(self._swa_cap, page_size)
+        # The private DFlash cache indexes full-pool locations. Charge all its
+        # layers, even though the target's sliding pool is bounded separately.
+        full_cell = (
+            self._full_cell_bytes()
+            + self._swa_per_token * self._draft_swa_full_layers_num
+            + self._draft_cell_size
+        )
+        full_tokens = (
+            (available_bytes - swa_tokens * self._swa_cell_bytes())
+            // full_cell // page_size * page_size
+        )
+        return self._make_pool_config(full_tokens, swa_tokens)
+
