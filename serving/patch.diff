+/** \brief One-shot push AR fused with Muse's unchanged residual/norm kernels.
+ * Each CTA pushes its part of one row before polling. All CTAs fit the existing
+ * push-counter budget; unused counters advance too, for interleaving with stock
+ * AR/finalize/AG. No private communication allocation or host synchronization.
+ */
+#include <sgl_kernel/distributed/communicator.cuh>
+#include <sgl_kernel/distributed/ptx.cuh>
+#include "norm_residual.cuh"
+
+namespace sglang {
+
+template <uint32_t World>
+struct ReduceNormParams : NormResidualParams {
+  device::distributed::PushWorkSpace<World> ws;
+  uint32_t rank;
+  uint32_t counters;
+  uint32_t chunk_rows;
+  uint32_t scatter_parts;
+  uint32_t* phase;
+};
+
+template <int64_t Hidden, uint32_t World, int Threads, int Cluster, bool Multicast>
+struct ReduceNormLoad {
+  using Params = ReduceNormParams<World>;
+  using Vec = device::AlignedVector<bf16x2_t, 4>;
+  using Lamport = device::distributed::LamportTrait<bf16_t, 8, 4>;
+
+  SGL_DEVICE static int begin(const Params& params) {
+    using namespace device;
+    const auto epoch = distributed::PushEpoch<World>{params.ws};
+    // A block owns the same elements for push and consume, independent of
+    // scheduling order. No barrier spans the grid.
+    const int row = blockIdx.x / Cluster;
+    const int lane = (blockIdx.x % Cluster) * Threads + threadIdx.x;
+    for (int v = lane; v < Hidden / 8; v += Threads * Cluster) {
+      const int vid = row * (Hidden / 8) + v;
+      Vec value;
+      value.load(params.branch, vid);
+      Lamport::clear_pos_zero(value.data());
+      if constexpr (Multicast) {
+        ptx::st_multimem_16B(value, params.ws.mc_workspace, epoch.slot_offset(params.rank) / 16 + vid);
+      } else {
+#pragma unroll
+        for (uint32_t peer = 0; peer < World; ++peer)
+          ptx::st_relaxed_16B(value, epoch.slot_ptr(peer, params.rank), vid);
+      }
+    }
+    if (blockIdx.x == 0) epoch.unsafe_flip_range(gridDim.x, params.counters);
+    return 0;
+  }
+
+  template <typename V>
+  SGL_DEVICE static V load(const Params& params, int, const bf16_t*, int index) {
+    using namespace device;
+    const auto epoch = distributed::PushEpoch<World>{params.ws};
+    const int vid = (blockIdx.x / Cluster) * (Hidden / 8) + index;
+    V values[World];
+    bool pending;
+    do {
+      pending = false;
+#pragma unroll
+      for (uint32_t peer = 0; peer < World; ++peer) {
+        ptx::ld_relaxed_16B(values[peer], epoch.slot_ptr(params.rank, peer), vid);
+        pending |= Lamport::has_pos_zero(values[peer].data());
+      }
+    } while (pending);
+    V zero;
+    Lamport::fill_pos_zero(zero.data());
+#pragma unroll
+    for (uint32_t peer = 0; peer < World; ++peer)
+      ptx::st_global_16B(zero, epoch.slot_ptr(params.rank, peer), vid);
+    // Same FP32 rank-order accumulation and BF16 rounding as generic push AR.
+    return reduce_vec(values);
+  }
+
+  SGL_DEVICE static void end(const Params& params, int) {
+    __syncthreads();
+    device::distributed::PushEpoch<World>{params.ws}.flip();
+  }
+};
+
+/// First shot: CTAs partition each full row of this rank's row partition.
+/// Scatter the other partitions, reduce this row and publish its BF16 sum.
+/// Epoch advancement is deferred until the gather/norm consumer has drained it.
+template <int64_t Hidden, uint32_t World, int Threads, bool Multicast>
+__global__ void __launch_bounds__(Threads) muse_reduce_scatter_rows(
+    const __grid_constant__ ReduceNormParams<World> params) {
+  using namespace device;
+  using Vec = AlignedVector<bf16x2_t, 4>;
+  using Lamport = distributed::LamportTrait<bf16_t, 8, 4>;
+  // This shot does not advance counters. Read the common entry phase rather
+  // than indexing by the producer grid, which may exceed stock's grid size.
+  const uint32_t phase = params.ws.counter[0].get();
+  const auto slot_ptr = [&](uint32_t dst, uint32_t src) {
+    return params.ws.workspaces[dst] + (src + phase * World) * params.ws.slot_bytes;
+  };
+
+  const uint32_t local_row = blockIdx.x / params.scatter_parts;
+  const uint32_t part = blockIdx.x % params.scatter_parts;
+  const uint32_t chunk_vecs = params.chunk_rows * (Hidden / 8);
+  if (blockIdx.x == 0 && threadIdx.x == 0)
+    *params.phase = params.ws.counter[0].get();
+#pragma unroll
+  for (uint32_t owner = 0; owner < World; ++owner) {
+    const uint32_t row = owner * params.chunk_rows + local_row;
+    if (owner == params.rank || row >= params.num_rows) continue;
+    for (uint32_t v = part * Threads + threadIdx.x; v < Hidden / 8; v += Threads * params.scatter_parts) {
+      Vec value;
+      value.load(params.branch, row * (Hidden / 8) + v);
+      Lamport::clear_pos_zero(value.data());
+      ptx::st_relaxed_16B(value, slot_ptr(owner, params.rank), local_row * (Hidden / 8) + v);
+    }
+  }
+  const uint32_t row = params.rank * params.chunk_rows + local_row;
+  if (row >= params.num_rows) return;
+  Vec marker;
+  Lamport::fill_pos_zero(marker.data());
+  for (uint32_t v = part * Threads + threadIdx.x; v < Hidden / 8; v += Threads * params.scatter_parts) {
+    const uint32_t j = local_row * (Hidden / 8) + v;
+    Vec values[World];
+    values[params.rank].load(params.branch, row * (Hidden / 8) + v);
+    Lamport::clear_pos_zero(values[params.rank].data());
+    bool pending;
+    do {
+      pending = false;
+#pragma unroll
+      for (uint32_t peer = 0; peer < World; ++peer) {
+        if (peer != params.rank) {
+          ptx::ld_relaxed_16B(values[peer], slot_ptr(params.rank, peer), j);
+          pending |= Lamport::has_pos_zero(values[peer].data());
+        }
+      }
+    } while (pending);
+    Vec reduced = reduce_vec(values);
+    // Match generic two-shot push's positive-zero marker remapping exactly.
+    Lamport::clear_pos_zero(reduced.data());
+    if constexpr (Multicast) {
+      ptx::st_multimem_16B(reduced, params.ws.mc_workspace,
+                         (params.rank + phase * World) * (params.ws.slot_bytes / 16) + chunk_vecs + j);
+    } else {
+#pragma unroll
+      for (uint32_t peer = 0; peer < World; ++peer)
+        ptx::st_relaxed_16B(reduced, slot_ptr(peer, params.rank), chunk_vecs + j);
+    }
+#pragma unroll
+    for (uint32_t peer = 0; peer < World; ++peer)
+      if (peer != params.rank)
+        ptx::st_global_16B(marker, slot_ptr(params.rank, peer), j);
+  }
+}
+
+/// Second shot: the existing norm body consumes each owner's reduced row.
+/// All CTAs read the saved phase, so M256 is independent of the counter count.
+template <int64_t Hidden, uint32_t World, int Cluster>
+struct GatherNormLoad {
+  using Params = ReduceNormParams<World>;
+  using Lamport = device::distributed::LamportTrait<bf16_t, 8, 4>;
+  SGL_DEVICE static int begin(const Params& params) { return *params.phase; }
+  template <typename Vec>
+  SGL_DEVICE static Vec load(const Params& params, int phase, const bf16_t*, int index) {
+    using namespace device;
+    const uint32_t row = blockIdx.x / Cluster;
+    const uint32_t owner = row / params.chunk_rows;
+    const uint32_t chunk_vecs = params.chunk_rows * (Hidden / 8);
+    const uint32_t j = (row % params.chunk_rows) * (Hidden / 8) + index;
+    auto* slot = params.ws.workspaces[params.rank]
+        + (owner + phase * World) * params.ws.slot_bytes;
+    Vec value;
+    do {
+      ptx::ld_relaxed_16B(value, slot, chunk_vecs + j);
+    } while (Lamport::has_pos_zero(value.data()));
+    Vec marker;
+    Lamport::fill_pos_zero(marker.data());
+    ptx::st_global_16B(marker, slot, chunk_vecs + j);
+    return value;
+  }
+  SGL_DEVICE static void end(const Params& params, int phase) {
+    // Later CTAs use the saved phase instead of these counters. The next
+    // collective is ordered after the whole gather/norm grid on this stream.
+    if (blockIdx.x == 0)
+      for (uint32_t i = threadIdx.x; i < params.counters; i += blockDim.x)
+        params.ws.counter[i].set(phase ^ 1);
+  }
+};
+
+template <int64_t Hidden, uint32_t World, int Threads, int Cluster, bool PDL, bool Multicast, bool Router, bool TwoShot = false>
+struct MuseAllReduceNormResidual {
+  /// The attention boundary has no post weight, has a pre weight and gated residual.
+  static void run(host::distributed::CommunicatorRef ref,
+                  tvm::ffi::TensorView branch, tvm::ffi::TensorView stream,
+                  tvm::ffi::TensorView output, tvm::ffi::TensorView new_stream,
+                  tvm::ffi::Optional<tvm::ffi::TensorView> router,
+                  tvm::ffi::TensorView pre_weight, tvm::ffi::TensorView alpha,
+                  tvm::ffi::TensorView beta, double post_eps, double pre_eps,
+                  tvm::ffi::Optional<tvm::ffi::TensorView> phase) {
+    using namespace host;
+    auto M = SymbolicSize{"tokens"};
+    auto G = SymbolicSize{"gate"};
+    auto dev = SymbolicDevice{};
+    TensorMatcher({M, Hidden}).with_dtype<bf16_t>().with_device<kDLCUDA>(dev)
+        .ensure_alignment(16).verify(branch).verify(output);
+    TensorMatcher({M, Hidden}).with_dtype<fp32_t>().with_device(dev)
+        .ensure_alignment(16).verify(stream).verify(new_stream);
+    CHECK_HOST(router.has_value() == Router);
+    if constexpr (Router)
+      TensorMatcher({M, Hidden}).with_dtype<fp32_t>().with_device(dev)
+          .ensure_alignment(16).verify(router.value());
+    TensorMatcher({Hidden}).with_dtype<bf16_t>().with_device(dev).ensure_alignment(16).verify(pre_weight);
+    TensorMatcher({G}).with_dtype<fp32_t>().with_device(dev).verify(alpha).verify(beta);
+    CHECK_HOST(G.unwrap() == 1 || G.unwrap() == Hidden);
+    const auto rows = static_cast<uint32_t>(M.unwrap());
+    CHECK_HOST(rows > 0);
+    const auto& plane = ref->get_push_obj();
+    const uint32_t chunk_rows = (rows + World - 1) / World;
+    CHECK_HOST(plane.num_blocks > 0);
+    CHECK_HOST(TwoShot || rows * Cluster <= plane.num_blocks);
+    CHECK_HOST(!Multicast || plane.mc_workspace != nullptr);
+    ReduceNormParams<World> params{};
+    params.branch = branch.data_ptr();
+    params.stream = stream.data_ptr();
+    params.output = output.data_ptr();
+    params.new_stream = new_stream.data_ptr();
+    params.router_out = Router ? router.value().data_ptr() : nullptr;
+    params.pre_weight = pre_weight.data_ptr();
+    params.alpha = alpha.data_ptr();
+    params.beta = beta.data_ptr();
+    params.post_eps = static_cast<float>(post_eps);
+    params.pre_eps = static_cast<float>(pre_eps);
+    params.num_rows = rows;
+    params.gate_channel_wise = G.unwrap() == Hidden;
+    params.has_pre_weight = true;
+    params.chunk_rows = chunk_rows;
+    params.scatter_parts = std::min<uint32_t>(8, Hidden / (128 * 8));
+    while (chunk_rows * params.scatter_parts > 128)
+      params.scatter_parts /= 2;
+    CHECK_HOST(params.scatter_parts > 0);
+    if constexpr (TwoShot) {
+      CHECK_HOST(phase.has_value());
+      TensorMatcher({1}).with_dtype<uint32_t>().with_device(dev).verify(phase.value());
+      params.phase = static_cast<uint32_t*>(phase.value().data_ptr());
+    }
+    const int64_t workspace_bytes = static_cast<int64_t>(TwoShot ? 2 * chunk_rows : rows) * Hidden * 2;
+    params.ws = plane.template get_workspace<World>(workspace_bytes);
+    params.rank = plane.rank;
+    params.counters = plane.num_blocks;
+    if constexpr (TwoShot) {
+      LaunchKernel(chunk_rows * params.scatter_parts, 128, dev.unwrap())(
+          muse_reduce_scatter_rows<Hidden, World, 128, Multicast>, params);
+    }
+    // The gather has no independent work before its input is ready. Avoid
+    // PDL waiters camping on SMs needed by the peer-dependent producer grid.
+    constexpr bool NormPDL = PDL && !TwoShot;
+    using Load = std::conditional_t<TwoShot, GatherNormLoad<Hidden, World, Cluster>,
+                                    ReduceNormLoad<Hidden, World, Threads, Cluster, Multicast>>;
+    if constexpr (Cluster == 1) {
+      LaunchKernel(rows, Threads, dev.unwrap()).config({.use_pdl = NormPDL})(
+          muse_spark_norm_residual_kernel<Hidden, Threads, NormPDL, true, false, Router, false, true, Load>, params);
+    } else {
+      LaunchKernel(rows * Cluster, Threads, dev.unwrap())
+          .config({.use_pdl = NormPDL, .cluster_dim = dim3(Cluster, 1, 1)})(
+              muse_spark_norm_residual_cluster<Hidden, Threads, Cluster, NormPDL, true, false, Router, false, true, Load>, params);
+    }
+  }
+};
+}  // namespace sglang
