+        threads,
+        cluster,
+        comm.has_multicast,
+        want_router,
+        two_shot,
+    ).run(
+        comm.obj,
+        branch,
+        stream,
+        output,
+        residual,
+        router,
+        pre_weight,
+        alpha,
+        beta,
+        post_eps,
+        pre_eps,
+        phase,
+    )
+    return output, residual, router
