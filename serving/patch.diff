+"""Drop-in TP8/EP8 prefill expert adapter.
+
+The compiled producer/consumer kernel lives in ``muse_spark_moe``.  This
+module owns the prefill shape policy so the model wiring can stay separate:
+large chunks use the persistent grouped TMA/WGMMA reader (fused W13
+SwiGLU), while the caller keeps smaller batches on receipt-backed V9 calls <=256.  The input is
+the BF16 pooler output after pre-expert norm; the returned dense slots and map
+are consumed by the model's existing post-expert norm/finalize operation.
+"""
+
+from __future__ import annotations
+
+import logging
+
+import torch
+
+logger = logging.getLogger(__name__)
+
+HIDDEN = 4096
+LOCAL_EXPERTS = 32
+TOP_K = 8
+PREFILL_ROWS = 753
+
+
+def prefill_expert_supported(hidden_states: torch.Tensor, topk_ids: torch.Tensor) -> bool:
+    return bool(
+        hidden_states.is_cuda
+        and hidden_states.dtype == torch.bfloat16
+        and hidden_states.ndim == 2
+        and hidden_states.shape[1] == HIDDEN
+        and PREFILL_ROWS <= hidden_states.shape[0] <= 16384
+        and topk_ids.is_cuda
+        and topk_ids.dtype in (torch.int32, torch.int64)
+        and tuple(topk_ids.shape) == (hidden_states.shape[0], TOP_K)
+    )
+
+
+class PrefillExpertPlan:
+    """Prepared canonical NVFP4 bank and graph-safe prefill dispatch."""
+
+    def __init__(self, state: dict):
+        self.state = state
+
+    @classmethod
+    def from_layer(cls, layer) -> "PrefillExpertPlan":
+        state = getattr(layer, "_muse_v4_state", None)
+        if state is None:
+            raise ValueError("prefill experts require the already-prepared canonical bank")
+        return cls(state)
+
+    def __call__(self, hidden_states, topk_scores, topk_ids):
+        if not prefill_expert_supported(hidden_states, topk_ids):
+            raise ValueError("unsupported Muse prefill expert shape or dtype")
+        from sglang.srt.layers.muse_spark_moe import H, NLOC, _grouped_call
+
+        data = {
+            "hidden_states": hidden_states.contiguous(),
+            "topk_ids": topk_ids.to(torch.int32).contiguous(),
+            "config": {
+                "local_count": NLOC,
+                "d_hidden": H,
+                "d_expert": H,
+                "local_start": self.state["local_start"],
+            },
+        }
+        return _grouped_call(data, self.state)
+
+
+def prepare_prefill_expert(layer) -> PrefillExpertPlan | None:
+    """Prepare after weights load; failures leave the caller's stock path intact."""
+    try:
+        return PrefillExpertPlan.from_layer(layer)
+    except Exception:
+        logger.warning(
+            "Muse prefill expert preparation failed; retaining stock expert dispatch",
+            exc_info=True,
+        )
+        return None
+
+
+def attach_prefill_expert(layer) -> PrefillExpertPlan | None:
+    """Serving-lane wiring hook: bind the plan without editing model code here."""
+    plan = prepare_prefill_expert(layer)
+    layer._muse_prefill_expert_plan = plan
+    return plan
+
+
+__all__ = [
+    "PREFILL_ROWS",
+    "PrefillExpertPlan",
+    "attach_prefill_expert",
+    "prefill_expert_supported",
+    "prepare_prefill_expert",
+]
