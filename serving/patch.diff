+cannot reduce the allocated KV capacity. Gate/up use separate FP32 sidecars.
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+import os
+
+import torch
+import triton
+import triton.language as tl
+
+logger = logging.getLogger(__name__)
+
+
+@triton.jit
+def _unpack(
+    C, W, S, BITS, ROWS: tl.constexpr, GATED: tl.constexpr, BLOCK: tl.constexpr
+):
+    v = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)
+    r, k = v // 4096, v % 4096
+    if GATED:
+        tile, ri, rr = (r % 4096) // 8, r // 4096, r % 8
+    else:
+        tile, ri, rr = r // 16, (r // 8) % 2, r % 8
+    w, g, q = k // 512, (k // 64) % 8, (k // 16) % 4
+    p, sl, j, h = (k // 8) % 2, (k // 4) % 2, (k // 2) % 2, k % 2
+    lane = rr * 4 + q
+    word = (((w * 8 + g) * 32 + lane) * 2 + p) * 2
+    a = tl.load(C + tile * 9216 + word, r < ROWS, 0).to(tl.uint32)
+    b = tl.load(C + tile * 9216 + word + 1, r < ROWS, 0).to(tl.uint32)
+    slot = sl * 4 + j * 2 + ri
+    code = tl.full((BLOCK,), 0, tl.uint32)
+    for bit in tl.static_range(4):
+        entry = tl.load(BITS + slot * 8 + h * 4 + bit)
+        code |= ((tl.where(entry >= 32, b, a) >> (entry % 32)) & 1) << bit
+    # Adjacent columns are the two nibbles of one serialized byte.
+    other = tl.gather(code, tl.arange(0, BLOCK) ^ 1, 0)
+    tl.store(W + v // 2, code | (other << 4), (r < ROWS) & (k % 2 == 0))
+    scale_idx = 32768 + ((((w * 8 + rr) * 4 + q) * 8 + g) * 2 + ri)
+    encoded = tl.load(
+        C.to(tl.pointer_type(tl.uint8)) + tile * 36864 + scale_idx, r < ROWS, 0
+    )
+    scale = tl.exp2((encoded.to(tl.int32) >> 3).to(tl.float32) - 21) * (
+        1 + (encoded & 7).to(tl.float32) / 8
+    )
+    scale = tl.where(encoded == 0, 0.0, scale).to(tl.float8e4nv)
+    tl.store(S + v // 16, scale, (r < ROWS) & (k % 16 == 0))
+
+
+def unpack_expert(bank, *, gated):
+    """Recover effective E2M1/E4M3 exactly, including signed/zero block scales."""
+    from sglang.srt.layers.muse_spark_moe import _TABLE
+
+    bits = torch.tensor(
+        [pos + (32 if word == "B" else 0) for _, _, _, word, pos in _TABLE],
+        dtype=torch.int32,
+        device=bank.device,
+    )
+    rows = bank.shape[0] * 16
+    w = torch.empty((rows, 2048), device=bank.device, dtype=torch.uint8)
+    s = torch.empty((rows, 256), device=bank.device, dtype=torch.float8_e4m3fn)
+    _unpack[(triton.cdiv(rows * 4096, 256),)](
+        bank.view(torch.int32),
+        w,
+        s,
+        bits,
+        rows,
+        gated,
+        256,
+    )
+    return w, s
+
+
+def _imports():
+    # The image has these helpers prebuilt. Avoid Humming's redundant import
+    # subprocess builds; restore its import-time setting before kernel builds.
+    previous = os.environ.get("HUMMING_DISABLE_PARALLEL_BUILD")
+    os.environ["HUMMING_DISABLE_PARALLEL_BUILD"] = "1"
+    try:
+        from humming import ops
+        from humming.config import GemmType, WeightScale2Type
+        from humming.kernel.humming import HummingKernel
+        from humming.layer import HummingMethod
+        from humming.schema.modelopt import ModeloptNvfp4WeightSchema
+        from humming.tune import get_heuristics_config
+    finally:
+        if previous is None:
+            os.environ.pop("HUMMING_DISABLE_PARALLEL_BUILD", None)
+        else:
+            os.environ["HUMMING_DISABLE_PARALLEL_BUILD"] = previous
+    return (
+        ops,
+        GemmType,
+        WeightScale2Type,
+        HummingKernel,
+        HummingMethod,
+        ModeloptNvfp4WeightSchema,
+        get_heuristics_config,
+    )
+
+
+class WideExperts:
+    """V11 indexed Humming producer with independent gate and up scales."""
+
+    def __init__(self, state):
+        ops, GemmType, Scale2, Kernel, Method, Schema, heuristic = _imports()
+        self.ops = ops
+        self.layer = torch.nn.Module()
+        self.state = state
+        banks = {name: [] for name in ("gate", "up", "down")}
+        for e in range(32):
+            w13, s13 = unpack_expert(state["w13p"][e], gated=True)
+            w2, s2 = unpack_expert(state["w2p"][e], gated=False)
+            for name, w, s, scale in (
+                ("gate", w13[:4096], s13[:4096], state["gs13_gate"][e : e + 1]),
+                ("up", w13[4096:], s13[4096:], state["gs13_up"][e : e + 1]),
+                ("down", w2, s2, state["gs2"][e : e + 1]),
+            ):
+                schema, tensors = Schema().convert_humming(
+                    tensors={
+                        "weight": w.unsqueeze(0).contiguous(),
+                        "weight_scale": s.unsqueeze(0).contiguous(),
+                        "weight_scale_2": scale,
+                    },
+                    shape_n_stacks=[4096],
+                    shape_k_stacks=[4096],
+                    param_dtype=torch.bfloat16,
+                    num_experts=1,
+                )
+                assert schema.weight_scale_2_type == Scale2.TENSOR
+                tmp = torch.nn.Module()
+                for key, value in tensors.items():
+                    setattr(tmp, key, torch.nn.Parameter(value, requires_grad=False))
+                Method.prepare_layer_meta(
+                    layer=tmp,
+                    shape_n=4096,
+                    shape_k=4096,
+                    weight_schema=schema,
+                    num_experts=1,
+                    pad_n_to_multiple=256,
+                    pad_k_to_multiple=128,
+                    torch_dtype=torch.bfloat16,
+                )
+                Method.transform_humming_layer(tmp)
+                banks[name].append({key: getattr(tmp, key).detach() for key in tensors})
+        # Gate/up become adjacent virtual experts, each retaining its own FP32
+        # tensor scale. One indexed launch still computes both products.
+        paired = [item for pair in zip(banks["gate"], banks["up"]) for item in pair]
+        banks = {"gate_up": paired, "down": banks["down"]}
+        self.weights = {
+            name: {
+                key: torch.cat([item[key] for item in items], dim=0) for key in items[0]
+            }
+            for name, items in banks.items()
+        }
+        self.plans = {}
+        compute = json.dumps(
+            {"use_f16_accum": False, "gemm_type": GemmType.INDEXED.value}
+        )
+        for name in self.weights:
+            meta = Method.prepare_layer_meta(
+                layer=self.layer,
+                shape_n=4096,
+                shape_k=4096,
+                weight_schema=schema,
+                num_experts=64 if name == "gate_up" else 32,
+                pad_n_to_multiple=256,
+                pad_k_to_multiple=128,
+                torch_dtype=torch.bfloat16,
+                sublayer_name=name,
+            )
+            tuning = dict(
+                heuristic(
+                    meta,
+                    shape_m=512 if name == "gate_up" else 256,
+                    gemm_type=GemmType.INDEXED,
+                )
+            )
+            if torch.cuda.get_device_capability() == (9, 0):
+                tuning.update(
+                    use_tma=True,
+                    use_tma_a=False,
+                    use_tma_as=False,
+                    use_tma_c=False,
+                    use_mbarrier=True,
+                    use_warp_spec=True,
+                )
+            # Keep a complete FP32 K reduction before the BF16 output seam.
+            tuning["use_stream_k"] = False
+            launch = Kernel.prepare_kernels(
+                meta.to_str(), compute, [[0, 1 << 30, tuning]]
+            )
+            self.plans[name] = (tuning["block_shape"][0], launch)
+        self.locks = torch.zeros(1024, dtype=torch.int32, device=state["w13p"].device)
+
+    def __call__(self, x, ids):
+        from sglang.kernels.ops.activation.activation import silu_and_mul
+        from sglang.srt.layers.moe.fused_moe_triton import moe_align_block_size
+
+        m, h = x.shape
+        local = ids.to(torch.int32) - self.state["local_start"]
+        local = torch.where(
+            (local >= 0) & (local < 32), local, torch.full_like(local, -1)
+        )
+        paired = torch.stack((local * 2, local * 2 + 1), dim=-1).view(m, 16)
+        paired = torch.where(paired >= 0, paired, torch.full_like(paired, -1))
+        act = None
+        for name, routing, count, topk in (
+            ("gate_up", paired, 64, 16),
+            ("down", local, 32, 1),
+        ):
+            bm, launch = self.plans[name]
+            sorted_ids, expert_ids, padded = moe_align_block_size(routing, bm, count)
+            source = x if name == "gate_up" else act
+            out = torch.empty((m * routing.shape[1], h), device=x.device, dtype=x.dtype)
+            self.ops.launch_kernel(
+                configs=launch,
+                inputs=source,
+                outputs=out,
+                **self.weights[name],
+                locks=self.locks,
+                sorted_ids=sorted_ids,
+                expert_ids=expert_ids,
+                num_tokens_padded=padded,
+                top_k=topk,
+                valid_shape_m=m * 2 if name == "gate_up" else m,
+            )
+            if name == "gate_up":
+                act = torch.empty((m * 8, h), device=x.device, dtype=x.dtype)
+                silu_and_mul(
+                    out.view(m * 8, h * 2),
+                    act,
+                    expert_ids=local.view(-1),
+                    expert_step=1,
+                )
+        flat = torch.arange(m * 8, dtype=torch.int32, device=x.device).view(m, 8)
+        return out.view(m, 8, h), torch.where(
+            local >= 0, flat, torch.full_like(flat, -1)
+        )
+
+
+def maybe_run_wide(layer, x, scores, ids):
+    """Spend one partial layout only after KV allocation, at the verify rung.
+
+    Model ownership selects one candidate layer. No process-global bank cache,
+    allocator override, or change to KV capacity. Larger calls use bounded V9 chunks.
+    """
+    if not getattr(layer, "_humming_candidate", False) or x.shape[0] != 256:
+        return None
+    state = getattr(layer, "_muse_v4_state", None)
+    if state is None or torch.cuda.get_device_capability(x.device) != (9, 0):
+        return None
+    if not hasattr(layer, "_humming_wide"):
+        if torch.cuda.is_current_stream_capturing():
+            raise RuntimeError("Muse wide expert producer must warm up before capture")
+        free, _ = torch.cuda.mem_get_info(x.device)
+        # Post-capture VMM pools can be virtually reserved but not yet backed.
+        # Charge their entire target and draft reservation before admitting a
+        # copy; otherwise a warmup allocation would silently steal final KV.
+        from sglang.srt.model_executor.forward_context import (
+            get_token_to_kv_pool,
+            has_forward_context,
+        )
+
+        pending_kv = 0
+        if has_forward_context():
+            pool = get_token_to_kv_pool()
+            if getattr(pool, "post_capture_active", False):
+                size = pool.get_kv_size_bytes()
+                logical = sum(size) if isinstance(size, tuple) else size
+                target_pending = max(0, logical - pool.post_capture_backed_bytes)
+                # Draft has five full-context layers, replicated 128-wide KV
+                # heads on TP8: 1280 B per token. It uses the target slot cap.
+                pending_kv = target_pending + pool.size * 1280
+        if free - pending_kv < 3 * 1024**3:
+            logger.info(
+                "Muse wide copy skipped: %.3f GB after pending KV",
+                (free - pending_kv) / 1e9,
+            )
+            layer._humming_wide = None
+        else:
+            wide = WideExperts(state)
+            from sglang.srt.layers.muse_spark_serving import run_v9_dense
+
+            choices = {
+                "v9": lambda: run_v9_dense(state, x, scores, ids),
+                "wide": lambda: wide(x, ids),
+            }
+            times = {}
+            for name, fn in choices.items():
+                fn()
+                graph = torch.cuda.CUDAGraph()
+                with torch.cuda.graph(graph):
+                    result = fn()
+                samples = []
+                for _ in range(5):
+                    begin = torch.cuda.Event(enable_timing=True)
+                    end = torch.cuda.Event(enable_timing=True)
+                    begin.record()
+                    graph.replay()
+                    end.record()
+                    end.synchronize()
+                    samples.append(begin.elapsed_time(end))
+                times[name] = sorted(samples)[len(samples) // 2]
+                graph.reset()
+                del result
+            layer._humming_wide = wide if times["wide"] < times["v9"] else None
+            logger.info(
+                "Muse one-layer wide selection: %s ms, selected=%s",
+                times,
+                layer._humming_wide is not None,
+            )
+    wide = layer._humming_wide
+    return None if wide is None else wide(x, ids)
