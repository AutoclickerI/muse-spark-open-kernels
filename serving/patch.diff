+    if(status==CUBLAS_STATUS_SUCCESS && checked.state==CUBLAS_STATUS_SUCCESS && checked.workspaceSize<=workspace)
+      {if(valid_count==capacity)overflow=true;else valid[valid_count++]=algo;}
