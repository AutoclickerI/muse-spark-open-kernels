+# Prefill only: above gemm_ag.MAX_TOKENS (512) the pooler and unpooler run replicated on every
+# rank. Arbitrary threshold; no measurement says where the row split starts to pay on H200.
+ROW_SPLIT_MIN_TOKENS = 1024
+
+
+def _use_row_split(tp_size: int, num_tokens: int) -> bool:
+    return (
+        tp_size > 1
+        and num_tokens >= ROW_SPLIT_MIN_TOKENS
+        and not _is_cpu
+        and not get_forward().sp_active
+        and not torch.cuda.is_current_stream_capturing()
+    )
+
+
+def _row_split_gemm(x: torch.Tensor, weight: torch.Tensor) -> torch.Tensor:
+    """``x @ weight.T`` with each TP rank computing ceil(M / world) rows, then all-gathered."""
+    tp_group = get_tp_group()
+    world, rank = tp_group.world_size, tp_group.rank_in_group
+    m = x.shape[0]
+    rows = -(-m // world)
+    lo, hi = min(rank * rows, m), min((rank + 1) * rows, m)
+    local = bf16_gemm_dispatch(x[lo:hi], weight, None)
+    if hi - lo < rows:
+        local = torch.nn.functional.pad(local, (0, 0, 0, rows - (hi - lo)))
+    out = local.new_empty(rows * world, weight.shape[0])
+    tp_group.all_gather_into_tensor(out, local)
+    return out[:m]
+
+
+def _reduce_scatter_rows_gemm(partial: torch.Tensor, weight: torch.Tensor) -> torch.Tensor:
+    """``all_reduce(partial) @ weight.T``: reduce-scatter rows, local GEMM, all-gather rows."""
+    tp_group = get_tp_group()
+    world = tp_group.world_size
+    m = partial.shape[0]
+    rows = -(-m // world)
+    if rows * world != m:
+        partial = torch.nn.functional.pad(partial, (0, 0, 0, rows * world - m))
+    reduced = partial.new_empty(rows, partial.shape[1])
+    tp_group.reduce_scatter_tensor(reduced, partial.contiguous())
+    local = bf16_gemm_dispatch(reduced, weight, None)
+    out = local.new_empty(rows * world, weight.shape[0])
+    tp_group.all_gather_into_tensor(out, local)
+    return out[:m]
+
+
 def _use_split_bf16_router(num_tokens: int) -> bool:
     if num_tokens <= ROUTER_GEMM_MAX_TOKENS or not _split_bf16_router_supported():
