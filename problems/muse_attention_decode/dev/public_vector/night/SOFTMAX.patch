nvf;\\n  const double a = (double)ang, k = rint(a * 0.15915494309189535);\\n  __sincosf((float)(a - k * 6.283185307179586), &sn, &cs);\\n}\\n__device__ __forceinline__ void rope_cs(const float* invf, int pos, int pair, float& sn, float& cs) {\\n  const float ang = (float)pos * invf[pair];\\n  const double a = (double)ang, k = rint(a * 0.15915494309189535);\\n  __sincosf((float)(a - k * 6.283185307179586), &sn, &cs);\\n}\\n\\n\\n#ifndef PV_CHAIN\\n#define PV_CHAIN 0\\n#endif\\n#ifndef PV_SHARE\\n#define PV_SHARE 0\\n#endif\\n__device__ __forceinline__ void pv_release(){\\n#if PV_CHAIN\\n asm volatile("griddepcontrol.launch_dependents;":::"memory");\\n#endif\\n}\\n__device__ __forceinline__ void pv_wait(){\\n#if PV_CHAIN\\n asm volatile("griddepcontrol.wait;":::"memory");\\n#endif\\n}\\ntemplate<typename K> static void pv_launch(K kernel,int g,int nt,int sm,cudaStream_t st,const A& a,const WF& f){\\n cudaLaunchConfig_t cfg={};cfg.gridDim=dim3(g);cfg.blockDim=dim3(nt);cfg.dynamicSmemBytes=sm;cfg.stream=st;\\n cudaLaunchAttribute attr={};attr.id=cudaLaunchAttributeProgrammaticStreamSerialization;\\n attr.val.programmaticStreamSerializationAllowed=1;\\n if(PV_CHAIN){cfg.attrs=&attr;cfg.numAttrs=1;}\\n auto e=cudaLaunchKernelEx(&cfg,kernel,a,f);TORCH_CHECK(e==cudaSuccess,cudaGetErrorString(e));\\n}\\n// 2^x on the FMA/ALU pipes (FA4-style MUFU offload): Cody-Waite split at the nearest integer, degree-3 minimax on [-0.5, 0.5]\\n// (max rel err 1.4e-4, below P\\\'s f16 rounding), integer part added to the exponent field; x clamped at -125 (masked scores)\\n__device__ __forceinline__ float ex2p(float x) {\\n  x = fmaxf(x, -125.f);\\n  const float t = x + 12582912.f, fr = x - (t - 12582912.f);\\n  const float q = fmaf(fmaf(fmaf(0.0550292665f, fr, 0.242256982f), fr, 0.693253055f), fr, 0.999951339f);\\n  return __int_as_float(__float_as_int(q) + (__float_as_int(t) << 23));\\n}\\n// e4m3 x 2 (low 16 bits of w; hi: bits 16..31) -> f16 x 2 on the integer pipes, scaled by 2^-8 (exp